rules_version = '2';

// पेंड Point — Storage rules (multi-store).
//
// Files live under stores/{storeId}/… so a store's photos are reachable
// only by that store's users (and a super admin). Roles and stores come
// from the same protected Firestore staff/{uid} and stores/{storeId}
// documents the Firestore rules use.
service firebase.storage {
  match /b/{bucket}/o {
    function staffDoc() {
      return /databases/(default)/documents/staff/$(request.auth.uid);
    }
    function me() { return firestore.get(staffDoc()).data; }
    function isActiveUser() {
      return request.auth != null
        && firestore.exists(staffDoc())
        && me().get('active', true) == true;
    }
    function isSuperAdmin() { return isActiveUser() && me().role == 'super_admin'; }
    function storeIsActive(sid) {
      return firestore.get(/databases/(default)/documents/stores/$(sid)).data.get('status', 'ACTIVE') == 'ACTIVE';
    }
    function isStoreUser(sid) {
      return isActiveUser()
        && me().role in ['admin', 'staff']
        && me().get('storeId', null) == sid
        && storeIsActive(sid);
    }
    function canUse(sid) { return isSuperAdmin() || isStoreUser(sid); }
    function canAdmin(sid) {
      return isSuperAdmin() || (isStoreUser(sid) && me().role == 'admin');
    }
    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /stores/{sid} {
      // Product images and brand logos — owner-managed master data.
      match /products/{productId}/{fileName} {
        allow read: if canUse(sid);
        allow create, update: if canAdmin(sid) && isImage();
        allow delete: if canAdmin(sid);
      }
      match /brands/{brandId}/{fileName} {
        allow read: if canUse(sid);
        allow create, update: if canAdmin(sid) && isImage();
        allow delete: if canAdmin(sid);
      }
      // Photos of suppliers' paper bills. Staff record purchases, so any
      // store user may add one; never overwritten (older revisions keep
      // theirs); only the owner may delete.
      match /purchase-bills/{purchaseId}/{fileName} {
        allow read: if canUse(sid);
        allow create: if canUse(sid) && isImage();
        allow update: if false;
        allow delete: if canAdmin(sid);
      }
    }

    // Files from before multi-store (all belong to the original store,
    // STORE001): readable by that store and a super admin; no new uploads.
    match /products/{productId}/{fileName} {
      allow read: if canUse('STORE001');
      allow write: if false;
      allow delete: if canAdmin('STORE001');
    }
    match /brands/{brandId}/{fileName} {
      allow read: if canUse('STORE001');
      allow write: if false;
      allow delete: if canAdmin('STORE001');
    }
    match /purchase-bills/{purchaseId}/{fileName} {
      allow read: if canUse('STORE001');
      allow write: if false;
      allow delete: if canAdmin('STORE001');
    }
  }
}
