rules_version = '2';

// पेंड Point — Firestore security rules.
// Model: the shop owner role is stored in the protected staff/{uid} document.
// It is not inferred from client-side data or an email address.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }
    function isStaff() { return isSignedIn(); } // any signed-in staff member

    // A batch may never be stored with negative available stock — the app
    // re-checks this inside its stock transaction, and the rules enforce it
    // server-side too so no client can oversell.
    function validBatch() {
      let d = request.resource.data;
      return d.bagsAvailable is int && d.bagsAvailable >= 0
        && d.looseKgAvailable is number && d.looseKgAvailable >= -0.001;
    }

    // Void / edit may only change a bill's or purchase's status markers —
    // amounts, items, party and date stay exactly as they were saved.
    function onlyStatusChange(replacedField) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', replacedField, 'statusChangedAt'])
        && request.resource.data.status == 'void';
    }

    // Catalogue: everyone signed in reads; only admin writes prices/products.
    match /brands/{id}   { allow read: if isStaff(); allow write: if isAdmin(); }
    match /products/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // Branch & Supplier masters: everyone signed in reads (needed for Stock
    // In's Branch/Supplier dropdowns); only admin manages the masters
    // themselves (see More → Branches / Suppliers, admin-gated in the app).
    // Party Master: suppliers are the purchase parties and customers (below)
    // the sales parties; a "both" party has one doc in each, same id — so
    // adding a purchase party stays admin-only.
    match /branches/{id}  { allow read: if isStaff(); allow write: if isAdmin(); }
    match /suppliers/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // Stock: staff read; staff may write via app (sale deduction, stock-in).
    match /stock/{id}     { allow read, write: if isStaff(); }
    match /stockLogs/{id} { allow read, create: if isStaff(); allow update, delete: if isAdmin(); }

    // Batches: the real, depletable inventory lots — staff write via app
    // (stock-in creates/tops-up a batch, a sale/void/transfer depletes or
    // credits one). Never hard-deleted by the app; deletion is admin-only as
    // a last resort.
    match /batches/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && validBatch();
      allow delete: if isAdmin();
    }

    // Bills: staff create & read; void and edit (edit = void the original
    // + create a corrected revision, in one transaction) are admin-only and
    // can only flip the status markers. Bills are never deleted.
    match /bills/{billId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.status == 'final';
      allow update: if isAdmin() && onlyStatusChange('replacedByBillId');
      allow delete: if false;     // never hard-delete a bill
      match /billItems/{itemId} { allow read, create: if isStaff(); allow update, delete: if false; }
    }

    // Purchase bills: same lifecycle as bills — staff record purchases,
    // only admin voids/edits them, never deleted. An optional bill photo is
    // written with the purchase (billPhotoUrl/billPhotoPath) at create time,
    // so no update rule is needed for it.
    match /purchases/{purchaseId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.status == 'final';
      allow update: if isAdmin() && onlyStatusChange('replacedByPurchaseId');
      allow delete: if false;
      match /purchaseItems/{itemId} { allow read, create: if isStaff(); allow update, delete: if false; }
    }

    // Customers / khata: staff manage.
    match /customers/{cid} {
      allow read, write: if isStaff();
      match /ledgerEntries/{eid} { allow read, create: if isStaff(); allow update, delete: if isAdmin(); }
    }

    // The first admin staff record is provisioned through the Firebase Console
    // or Admin SDK; clients cannot create or elevate staff records.
    match /staff/{id} {
      allow read: if isStaff();
      allow create: if isAdmin();
      // An administrator may manage other staff, but cannot accidentally
      // demote/deactivate their own account through the client.
      allow update: if isAdmin() && (id != request.auth.uid ||
        (request.resource.data.role == resource.data.role &&
         request.resource.data.active == resource.data.active));
      allow delete: if false;
    }
    match /meta/counters { allow read, write: if isStaff(); }
    match /meta/settings { allow read: if isStaff(); allow write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
