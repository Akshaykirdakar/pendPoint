rules_version = '2';

// पेंड Point — Firestore security rules.
// Model: the shop owner role is stored in the protected staff/{uid} document.
// It is not inferred from client-side data or an email address.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }
    function isStaff() { return isSignedIn(); } // any signed-in staff member

    // Catalogue: everyone signed in reads; only admin writes prices/products.
    match /brands/{id}   { allow read: if isStaff(); allow write: if isAdmin(); }
    match /products/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // Stock: staff read; staff may write via app (sale deduction, stock-in).
    match /stock/{id}     { allow read, write: if isStaff(); }
    match /stockLogs/{id} { allow read, create: if isStaff(); allow update, delete: if isAdmin(); }

    // Bills: staff create & read; voids (status change) admin-only.
    match /bills/{billId} {
      allow read, create: if isStaff();
      allow update: if isAdmin(); // voiding
      allow delete: if false;     // never hard-delete a bill
      match /billItems/{itemId} { allow read, create: if isStaff(); allow update, delete: if false; }
    }

    // Customers / khata: staff manage.
    match /customers/{cid} {
      allow read, write: if isStaff();
      match /ledgerEntries/{eid} { allow read, create: if isStaff(); allow update, delete: if isAdmin(); }
    }

    // The first admin staff record is provisioned through the Firebase Console
    // or Admin SDK; clients cannot create or elevate staff records.
    match /staff/{id} {
      allow read: if isStaff();
      allow create: if isAdmin();
      // An administrator may manage other staff, but cannot accidentally
      // demote/deactivate their own account through the client.
      allow update: if isAdmin() && (id != request.auth.uid ||
        (request.resource.data.role == resource.data.role &&
         request.resource.data.active == resource.data.active));
      allow delete: if false;
    }
    match /meta/counters { allow read, write: if isStaff(); }
    match /meta/settings { allow read: if isStaff(); allow write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
